APP_NAME=ParentShield
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Wajib: set APP_KEY di Vercel dashboard (base64:xxx)
# Generate: php artisan key:generate --show

# ──────────────────────────────────────────
# Database: TiDB Serverless (MySQL-compatible)
# ──────────────────────────────────────────
# Daftar gratis → https://tidbcloud.com/free-trial
# Create cluster → klik "Connect" → dapatkan credential
# Contoh:
#   DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
#   DB_PORT=4000
#   DB_DATABASE=test
#   DB_USERNAME=2kC7M6ah7S7JwJx.root
#   DB_PASSWORD=<generated-password>
DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=4000
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

CACHE_STORE=array

SESSION_DRIVER=array

QUEUE_CONNECTION=sync

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SANCTUM_TOKEN_PREFIX=

FILESYSTEM_DISK=local
